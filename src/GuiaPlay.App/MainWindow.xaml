        <Style x:Key="GPActiveHeaderButton" TargetType="Button" BasedOn="{StaticResource GPHeaderButton}">
            <Setter Property="Background" Value="{DynamicResource GuiaPlayAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayAccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SavedPlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
