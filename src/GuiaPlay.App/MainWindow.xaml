<Window x:Class="GuiaPlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GuiaPlay.App.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GuiaPlay"
        Icon="/GuiaPlay;component/Assets/Branding/Icons/GuiaPlay.ico"
        Width="1536" Height="1024" MinWidth="1120" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource GuiaPlayWindowBackgroundBrush}"
        Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
