        <Style x:Key="CompactTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <!-- GP-I16: operator-grade raised action, rather than the default WPF pushbutton. -->
        <!-- GP-I18: compact 36-DIP secondary toolbar; primary Adicionar remains slightly taller at 38 DIP. -->
        <Style x:Key="GPToolbarSecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CompactTransportButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- GP-I23: compact, theme-aware operator controls. Keep Adicionar as
             the distinct primary action, and unify the secondary actions. -->
        <Style x:Key="GPMediaToolbarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource GPToolbarSecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource GuiaPlayControlSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryActionSurface" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryActionSurface" Property="Background"
                                        Value="{DynamicResource GuiaPlayControlHoverBrush}"/>
                                <Setter TargetName="SecondaryActionSurface" Property="BorderBrush"
                                        Value="{DynamicResource GuiaPlayAccentBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryActionSurface" Property="Background"
                                        Value="{DynamicResource GuiaPlaySelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SecondaryActionSurface" Property="BorderBrush"
                                        Value="{DynamicResource GuiaPlayAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecondaryActionSurface" Property="Opacity" Value="0.43"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GPMediaRowActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource GPMediaToolbarButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GPAddMediaButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactPrimaryButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1599FF" Offset="0"/>
                        <GradientStop Color="#FF1263EC" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#FF57B9FF" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF006BFA" BlurRadius="13" ShadowDepth="3" Opacity="0.33"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="#FFC3EEFF"/>
                                <Setter TargetName="ActionSurface" Property="Background" Value="#FF187DFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="#FF064DBB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.43"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaylistCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <!-- GP-I01: all header actions map to existing, tested application workflows. -->
        <Style x:Key="HeaderNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderNavigationIconStyle" TargetType="Path" BasedOn="{StaticResource ButtonIconStyle}">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <!-- GP-I22: custom seek slider. WPF's OS-dependent Slider template used
             to clip/tint the thumb at the top edge. All track components have a
             fixed 28-DIP vertical lane, and the thumb is centered inside it. -->
        <Style x:Key="GPSeekDecreaseButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent" Height="28">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                    Background="#FF27A9F6"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GPSeekIncreaseButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent" Height="28">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                    Background="#FF3A5068"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GPSeekThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="22" Height="22" Background="Transparent"
                              SnapsToDevicePixels="True">
                            <Ellipse Width="22" Height="22" Fill="#203AAEFF"/>
                            <Ellipse Width="16" Height="16" Fill="#FF28AEFF"
                                     Stroke="#FFDAF5FF" StrokeThickness="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GPSeekSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" Height="28"
                                   Orientation="Horizontal" VerticalAlignment="Center"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource GPSeekDecreaseButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GPSeekThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource GPSeekIncreaseButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GPRoundTransport" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="35"/><Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="1,0"/><Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource GuiaPlayControlSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="80" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}"/>
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="GPPlayTransport" TargetType="Button" BasedOn="{StaticResource GPRoundTransport}">
            <Setter Property="Height" Value="48"/><Setter Property="Width" Value="48"/>
            <Setter Property="Padding" Value="8"/><Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF158FFF" Offset="0"/>
                        <GradientStop Color="#FF0762EC" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFC6E5FF"/><Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Hero" Background="{TemplateBinding Background}" CornerRadius="90"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect><DropShadowEffect Color="#FF147FFF" BlurRadius="7" ShadowDepth="0" Opacity="0.57"/></Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hero" Property="Opacity" Value="0.87"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Hero" Property="Opacity" Value="0.82"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="GPPlaybackToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="29"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
