        <Style x:Key="CompactTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="PlaylistCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <!-- GP-I01: all header actions map to existing, tested application workflows. -->
        <Style x:Key="HeaderNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderNavigationIconStyle" TargetType="Path" BasedOn="{StaticResource ButtonIconStyle}">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="GPRoundTransport" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="7,0"/><Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource GuiaPlayControlSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="80" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}"/>
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="GPPlayTransport" TargetType="Button" BasedOn="{StaticResource GPRoundTransport}">
            <Setter Property="Height" Value="86"/><Setter Property="Width" Value="86"/>
            <Setter Property="Padding" Value="21"/><Setter Property="Background" Value="{DynamicResource GuiaPlayAccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FFC6E5FF"/><Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Hero" Background="{TemplateBinding Background}" CornerRadius="90"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect><DropShadowEffect Color="#FF147FFF" BlurRadius="24" ShadowDepth="0" Opacity="0.75"/></Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hero" Property="Opacity" Value="0.87"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Hero" Property="Opacity" Value="0.48"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="GPPlaybackToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="IconSurface" Background="Transparent"
                                CornerRadius="7" BorderThickness="1" BorderBrush="Transparent"
                                Padding="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource GuiaPlayAccentSubtleBrush}"/>
                                <Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GuiaPlayAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="IconSurface" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GPHeaderButton" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Panel" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="9">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Panel" Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Panel" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="GPActiveHeaderButton" TargetType="Button" BasedOn="{StaticResource GPHeaderButton}">
            <Setter Property="Background" Value="{DynamicResource GuiaPlayAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayAccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SavedPlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource GuiaPlayAccentBrush}" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutputChipStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GuiaPlayControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CheckGlyph" Text="✓" Margin="0,0,5,0" FontWeight="SemiBold" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                                <Setter TargetName="ChipSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBorderBrush}" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:PlaylistGroupNode}" ItemsSource="{Binding Items}">
            <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource FolderOpenIconGeometry}" Width="15" Height="15"
                      Fill="{DynamicResource GuiaPlayAccentBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="5,0,0,0"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Margin="6,0,2,0" Padding="7,2" CornerRadius="9"
                        Background="{DynamicResource GuiaPlayAccentSubtleBrush}">
                    <TextBlock Text="{Binding Items.Count}" FontSize="11" />
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:PlaylistItemNode}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Path x:Name="ItemKindIcon" Data="{StaticResource VideoIconGeometry}" Width="14" Height="14"
                      Stretch="Uniform" Fill="{DynamicResource GuiaPlayTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ItemName" Grid.Column="1" Margin="6,0,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="{Binding AvailabilityLabel}"
                           FontSize="11" Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding KindLabel}" Value="Áudio">
                    <Setter TargetName="ItemKindIcon" Property="Path.Data" Value="{StaticResource MusicIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="ItemName" Property="TextBlock.TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="ItemName" Property="TextBlock.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- GP-I13: immersive window chrome; no decorative navigation. -->
        <Border Grid.Row="0" Background="{DynamicResource GuiaPlayWindowBackgroundBrush}" BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                BorderThickness="0,0,0,1" Height="78" Margin="0,0,0,11" Padding="26,0,20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,23,0">
                    <Image Source="/GuiaPlay;component/Assets/Branding/Icons/GuiaPlay.ico" Width="42" Height="42" Margin="0,0,8,0"/>
                    <Image Source="/GuiaPlay;component/Assets/Branding/GuiaPlay-Wordmark-UI.png" Width="143" Height="44" Stretch="Uniform"/>
                    <TextBlock x:Name="VersionHeaderText" Text="v—" FontSize="12" Margin="8,0,0,0"
                               Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center" Focusable="False" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="HeaderPlaylistButton" Click="HeaderPlaylistButton_OnClick" Style="{StaticResource GPActiveHeaderButton}" ToolTip="Playlist" AutomationProperties.Name="Playlist"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPPlaylist}" Style="{StaticResource ButtonIconStyle}" Width="21" Height="21"/><TextBlock Text="Playlist" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
                        <Button x:Name="HeaderMediaButton" Click="HeaderMediaButton_OnClick" Style="{StaticResource GPHeaderButton}" ToolTip="Mídia" AutomationProperties.Name="Mídia"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPVideo}" Style="{StaticResource ButtonIconStyle}" Width="21" Height="21"/><TextBlock Text="Mídia" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
                        <Button Click="HeaderSettingsButton_OnClick" Style="{StaticResource GPHeaderButton}" ToolTip="Configurações" AutomationProperties.Name="Configurações"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource ButtonIconStyle}" Width="21" Height="21"/><TextBlock Text="Configurações" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
                        <Button Click="HeaderMonitorsButton_OnClick" Style="{StaticResource GPHeaderButton}" ToolTip="Monitores" AutomationProperties.Name="Monitores"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPMonitors}" Style="{StaticResource ButtonIconStyle}" Width="21" Height="21"/><TextBlock Text="Monitores" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
                        <Button Click="HeaderAboutButton_OnClick" Style="{StaticResource GPHeaderButton}" ToolTip="Sobre" AutomationProperties.Name="Sobre"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource InfoIconGeometry}" Style="{StaticResource ButtonIconStyle}" Width="21" Height="21"/><TextBlock Text="Sobre" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
                        <Button Click="KeyboardShortcutsButton_OnClick" Style="{StaticResource GPHeaderButton}" ToolTip="Atalhos (F1)"><StackPanel Orientation="Horizontal"><TextBlock Text="⌨" FontSize="18" Margin="0,0,7,0"/><TextBlock Text="Atalhos" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Ellipse x:Name="LicenseStatusDot" Width="11" Height="11" Fill="#FF8A97AB" Margin="0,0,4,0"/>
                    <Button x:Name="LicenseStatusButton" Content="Verificando licença…" Style="{StaticResource GPHeaderButton}" MinHeight="43" FontSize="13" Click="LicenseStatusButton_OnClick" ToolTip="Gerenciar licença"/>
                    <Button x:Name="UpdateAvailableButton" Visibility="Collapsed" Width="43" Height="42" Style="{StaticResource GPHeaderButton}" Click="UpdateAvailableButton_OnClick" ToolTip="Atualização disponível"><Path Data="{StaticResource ArrowDownloadIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0"/></Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="15,0,0,0"
                            VerticalAlignment="Stretch" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="43" Content="—" Background="Transparent" BorderThickness="0" FontSize="17" Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}" Click="TitleBarMinimize_OnClick" ToolTip="Minimizar" AutomationProperties.Name="Minimizar janela"/>
                    <Button Width="43" Content="□" Background="Transparent" BorderThickness="0" FontSize="21" Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}" Click="TitleBarMaximize_OnClick" ToolTip="Maximizar ou restaurar" AutomationProperties.Name="Maximizar ou restaurar janela"/>
                    <Button Width="43" Content="×" Background="Transparent" BorderThickness="0" FontSize="28" Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}" Click="TitleBarClose_OnClick" ToolTip="Fechar" AutomationProperties.Name="Fechar janela"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="LicensedWorkspace" Grid.Row="1" Margin="14,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="49*" MinHeight="225" />
                <RowDefinition Height="51*" MinHeight="200" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="255" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="345" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="294" MinWidth="270" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- GP-I05: Operator and Program use one actual shared frame source.
                         Program is a transmission mirror, not a capture of the physical monitor. -->
                    <Grid Margin="2,0,2,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PRÉVIA (OPERADOR) / PROGRAMA (TELA PÚBLICA)" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="FileNameText" Text="Nenhuma mídia carregada"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                       Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="8,4" VerticalAlignment="Top"
                                CornerRadius="11" Background="{DynamicResource GuiaPlayAccentSubtleBrush}"
                                BorderBrush="{DynamicResource GuiaPlayAccentBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="PreviewLiveStateText" Text="AGUARDANDO"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1"
                                Background="{DynamicResource GuiaPlaySurfaceSecondaryBrush}" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,1,4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PRÉVIA (OPERADOR)" FontSize="11" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="LOCAL" FontSize="9" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True"
                                        MinHeight="110">
                                    <Grid>
                                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                                        <StackPanel x:Name="PreviewEmptyState" Margin="12"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    MaxWidth="220">
                                            <Path Data="{StaticResource VideoIconGeometry}" Width="26" Height="26"
                                                  Stretch="Uniform" Fill="#FF8F98A6"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock x:Name="PreviewPlaceholder" Text="Nenhuma mídia carregada"
                                                       Foreground="#FFE2E5EA" FontWeight="SemiBold"
                                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                            <TextBlock x:Name="PreviewEmptyHint" Text="Abra uma mídia ou selecione na playlist"
                                                       Foreground="#FF9FA7B3" FontSize="10"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Same LibVLC position as transport below; bindings prevent drift. -->
                                <Grid Grid.Row="2" Margin="2,6,2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="39" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text, ElementName=ElapsedText}"
                                               VerticalAlignment="Center" FontSize="10" />
                                    <Slider x:Name="PreviewProgressSlider" Grid.Column="1" Margin="5,0"
                                            Minimum="0" Maximum="{Binding Maximum, ElementName=ProgressSlider}"
                                            Value="{Binding Value, ElementName=ProgressSlider, Mode=TwoWay}"
                                            ValueChanged="ProgressSlider_OnValueChanged"
                                            IsEnabled="False" ToolTip="Arraste para buscar a posição do vídeo"
                                            Foreground="{DynamicResource GuiaPlayAccentBrush}"
                                            PreviewMouseLeftButtonDown="ProgressSlider_OnDragStarted"
                                            PreviewMouseLeftButtonUp="ProgressSlider_OnDragCompleted"
                                            PreviewMouseWheel="ProgressSlider_OnMouseWheel" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text, ElementName=RemainingText}"
                                               TextAlignment="Right" VerticalAlignment="Center" FontSize="9"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="8"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1"
                                Background="{DynamicResource GuiaPlaySurfaceSecondaryBrush}" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,1,4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PROGRAMA / TELA PÚBLICA" FontSize="11"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ProgramStatusBadgeText" Grid.Column="1"
                                               Text="SEM SAÍDA" FontSize="9"
                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                                </Grid>
                                <Border Grid.Row="1" Background="Black" CornerRadius="6"
                                        ClipToBounds="True" MinHeight="110">
                                    <Grid>
                                        <Image x:Name="ProgramImage" Stretch="Uniform" Visibility="Collapsed"
                                               ToolTip="Espelho do quadro entregue pelo GuiaPlay às janelas públicas; não é captura física do monitor" />
                                        <StackPanel x:Name="ProgramEmptyState" Margin="12"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    MaxWidth="220">
                                            <Path Data="{StaticResource DisplayIconGeometry}" Width="26" Height="26"
                                                  Stretch="Uniform" Fill="#FF8F98A6"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock x:Name="ProgramPlaceholderText"
                                                       Text="Nenhuma saída pública ativa"
                                                       Foreground="#FFE2E5EA" FontSize="12"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                            <TextBlock x:Name="ProgramDetailsText"
                                                       Text="Escolha uma tela e inicie um vídeo"
                                                       Foreground="#FF9FA7B3" FontSize="10"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                            <TextBlock x:Name="YouTubeStatusHintText" Text="" Visibility="Collapsed"
                                                       Foreground="#FFF2A900" FontSize="10"
                                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- GP-I02: saved presets and working groups are real persisted data, not mock folders. -->
            <Grid Grid.Column="0" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="60*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardStyle}"
                        Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}" Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GPFolderOpen}" Width="17" Height="17"
                                      Stretch="Uniform" Fill="{DynamicResource GuiaPlayAccentBrush}"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="PLAYLISTS" FontSize="14" FontWeight="SemiBold"
                                           Margin="7,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="SavedPlaylistsCountText" Text="0"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                           VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="+" ToolTip="Criar nova playlist vazia"
                                    AutomationProperties.Name="Nova playlist"
                                    Style="{StaticResource PlaylistCommandButtonStyle}"
                                    Click="NewPlaylistButton_OnClick" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="SavedPlaylistsList" Background="Transparent"
                                     BorderThickness="0" SelectionMode="Single"
                                     ItemContainerStyle="{StaticResource SavedPlaylistItemStyle}"
                                     SelectionChanged="SavedPlaylistsList_OnSelectionChanged"
                                     MouseDoubleClick="SavedPlaylistsList_OnMouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Playlists salvas">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SavedPlaylistEntry}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource GPPlaylist}"
                                                  Fill="{DynamicResource GuiaPlayAccentBrush}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveLabel}"
                                                               Margin="3,0,0,0" FontSize="9"
                                                               Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis"
                                                           FontSize="10" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="SavedPlaylistsEmptyText"
                                       Text="Nenhuma playlist salva. Use Salvar para criar uma."
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="9" TextAlignment="Center" TextWrapping="Wrap"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Nova" Margin="0,0,3,0"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Iniciar uma playlist de trabalho vazia"
                                    Click="NewPlaylistButton_OnClick" />
                            <Button Grid.Column="1" Content="Salvar" Margin="2,0,2,0"
                                    Style="{StaticResource CompactPrimaryButtonStyle}"
                                    ToolTip="Salvar a playlist de trabalho como preset"
                                    Click="SavePlaylistPresetButton_OnClick" />
                            <Button x:Name="OpenSelectedPresetButton" Grid.Column="2" Content="Abrir"
                                    Margin="2,0,2,0" IsEnabled="False"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Carregar a playlist selecionada"
                                    Click="OpenSelectedPresetButton_OnClick" />
                            <Button x:Name="DeleteSelectedPresetButton" Grid.Column="3" Content="Excluir"
                                    Margin="3,0,0,0" IsEnabled="False"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Excluir somente o preset selecionado, com confirmação"
                                    Click="DeleteSelectedPresetButton_OnClick" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                        Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}" Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PASTAS" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Grupos da playlist de trabalho" FontSize="10"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="NewGroupButton_OnClick" ToolTip="Criar grupo virtual"
                                        AutomationProperties.Name="Criar grupo"
                                        Style="{StaticResource PlaylistCommandButtonStyle}" Margin="0,0,3,0">
                                    <Path Data="{StaticResource FolderAddIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                                </Button>
                                <Button Click="RenameGroupButton_OnClick" ToolTip="Renomear grupo selecionado"
                                        AutomationProperties.Name="Renomear grupo"
                                        Style="{StaticResource PlaylistCommandButtonStyle}" Margin="0,0,3,0">
                                    <Path Data="{StaticResource EditIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                                </Button>
                                <Button Click="DeleteGroupButton_OnClick" ToolTip="Excluir grupo e referências, sem apagar mídias"
                                        AutomationProperties.Name="Excluir grupo"
                                        Style="{StaticResource PlaylistCommandButtonStyle}">
                                    <Path Data="{StaticResource DeleteIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" CornerRadius="7" Padding="4"
                                Background="{DynamicResource GuiaPlayControlSurfaceBrush}"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1">
                            <Grid>
                                <TreeView x:Name="PlaylistTree" MouseDoubleClick="PlaylistTree_OnMouseDoubleClick"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="PlaylistTree_OnPreviewMouseLeftButtonDown"
                                          PreviewMouseMove="PlaylistTree_OnPreviewMouseMove"
                                          PreviewDragOver="PlaylistTree_OnPreviewDragOver"
                                          Drop="PlaylistTree_OnDrop" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="Grupos e mídias da playlist" />
                                <StackPanel x:Name="PlaylistEmptyState" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" MaxWidth="230" IsHitTestVisible="False">
                                    <Path Data="{StaticResource FolderAddIconGeometry}"
                                          Width="27" Height="27" Stretch="Uniform"
                                          Fill="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                          HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Lista de trabalho vazia" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="Crie um grupo e adicione arquivos ou pastas com o botão Adicionar."
                                               Style="{StaticResource SecondaryTextStyle}"
                                               TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="WorkingPlaylistSummaryText" Text="0 grupos · 0 mídias"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                <TextBlock x:Name="FolderImportStatusText" Text="Importação de pasta não iniciada"
                                           FontSize="10" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                           Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                                <Button x:Name="CancelFolderImportButton" Visibility="Collapsed" Content="Cancelar leitura"
                                        HorizontalAlignment="Left" Margin="0,3,0,0"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Cancelar varredura sem modificar a playlist"
                                        Click="CancelFolderImportButton_OnClick" />
                            </StackPanel>
                            <Button Grid.Column="1" Grid.ColumnSpan="2"
                                    Content="Nova pasta / grupo" Margin="4,0,0,0"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Criar um grupo na playlist de trabalho"
                                    Click="NewGroupButton_OnClick" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- GP-I13: independent output and audio cards from the approved reference. -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions><RowDefinition Height="57*"/><RowDefinition Height="43*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10"
                        Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="{DynamicResource GuiaPlaySurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0" Padding="14,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GPMonitors}" Width="21" Height="21" Stretch="Uniform"
                                      Fill="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                <TextBlock Text="SAÍDA DE VÍDEO" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Margin="9,7" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <ItemsControl x:Name="SidebarOutputsList" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding ShortLabel}" ToolTip="{Binding Label}"
                                                  AutomationProperties.Name="{Binding ShortLabel}"
                                                  Margin="0,0,0,5" Padding="7,6" Style="{StaticResource OutputChipStyle}"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoPublicMonitorsText" Text="Nenhuma tela pública disponível."
                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" IsHitTestVisible="False"/>
                            </Grid>
                        </ScrollViewer>
                        <Grid Grid.Row="2" Margin="10,3,10,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="OutputSelectedCountText" Text="0 selecionadas"
                                       FontSize="11" Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                       VerticalAlignment="Center" ToolTip="Saídas de vídeo selecionadas"/>
                            <Button x:Name="IdentifyButton" Grid.Column="1" Content="Identificar telas"
                                    Click="IdentifyButton_OnClick" Height="29" MinWidth="0" Padding="9,3"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Identificar os monitores conectados"/>
                            <!-- Live diagnostics remain available to handlers without cluttering the card. -->
                            <StackPanel Visibility="Collapsed">
                                <TextBlock x:Name="ActiveOutputsText" Text="Nenhuma"/>
                                <TextBlock x:Name="OperatorPanelText" Text="Operador: detectando…"/>
                                <TextBlock x:Name="OperatorStatusText"/>
                                <TextBlock x:Name="MonitorWarning"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0"
                        Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{DynamicResource GuiaPlaySurfaceElevatedBrush}"
                                CornerRadius="8,8,0,0" BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                                BorderThickness="0,0,0,1" Padding="14,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GPVolumeUp}" Width="22" Height="22" Stretch="Uniform"
                                      Fill="{DynamicResource GuiaPlayTextSecondaryBrush}"/>
                                <TextBlock Text="ÁUDIO" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="AudioAvailabilityText" Visibility="Collapsed" Text="Verificando" FontSize="10" Margin="8,0,0,0"
                                           Foreground="{DynamicResource GuiaPlayAccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" Margin="14,10,14,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Dispositivo de saída" FontSize="12"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"/>
                            <Button Grid.Row="1" Click="ChangeAudioOutputButton_OnClick"
                                    Margin="0,8,0,0" Padding="10,8" Height="39" MinWidth="0"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Selecionar o dispositivo de áudio nas configurações">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AudioDeviceNameText" Text="Padrão do Windows" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="{StaticResource GPArrowDown}" Width="15" Height="15"
                                          Stretch="Uniform" Fill="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="AudioWarningText" Visibility="Collapsed" Grid.Row="2"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- GP-I12: media actions and table span the entire preview/output workspace,
                 matching the approved horizontal layout instead of being squeezed
                 into the operator preview card. Backed by real playlist data. -->
                    <!-- GP-I03: playback-order grid linked to the existing playlist catalog. -->
                    <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,12,0,0" CornerRadius="9" BorderThickness="1"
                            Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource GuiaPlayDividerBrush}" Padding="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="AddMediaMenuButton"
                                        Click="AddMediaMenuButton_OnClick" Margin="0,0,6,0" Height="41"
                                        Style="{StaticResource CompactPrimaryButtonStyle}"
                                        ToolTip="Adicionar arquivo, pasta completa ou link do YouTube"
                                        AutomationProperties.Name="Adicionar mídias">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GPPlus}"
                                              Style="{StaticResource ButtonIconStyle}" />
                                        <TextBlock Text="Adicionar  ⌄" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Margin="0,0,6,0"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Criar uma playlist vazia"
                                        Click="NewPlaylistButton_OnClick"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPPlaylist}" Style="{StaticResource ButtonIconStyle}" Width="17" Height="17"/><TextBlock Text="Nova Playlist" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Grid.Column="2" Margin="0,0,6,0"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Salvar a playlist"
                                        Click="SavePlaylistPresetButton_OnClick"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPSave}" Style="{StaticResource ButtonIconStyle}" Width="17" Height="17"/><TextBlock Text="Salvar" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Grid.Column="3" x:Name="MediaRemoveSelectedButton"
                                        Margin="0,0,6,0" IsEnabled="False"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Remover da lista a mídia selecionada na tabela sem excluir o arquivo"
                                        Click="RemoveSelectedMediaButton_OnClick"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPTrash}" Style="{StaticResource ButtonIconStyle}" Width="17" Height="17"/><TextBlock Text="Remover" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button x:Name="MediaMoveUpButton" Grid.Column="4"
                                        IsEnabled="False" MinWidth="31" Margin="0,0,4,0"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Mover a mídia selecionada para cima"
                                        AutomationProperties.Name="Subir mídia"
                                        Click="MediaMoveUpButton_OnClick"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPArrowUp}" Style="{StaticResource ButtonIconStyle}" Width="17" Height="17"/><TextBlock Text="" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button x:Name="MediaMoveDownButton" Grid.Column="5"
                                        IsEnabled="False" MinWidth="31"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Mover a mídia selecionada para baixo"
                                        AutomationProperties.Name="Descer mídia"
                                        Click="MediaMoveDownButton_OnClick"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GPArrowDown}" Style="{StaticResource ButtonIconStyle}" Width="17" Height="17"/><TextBlock Text="" VerticalAlignment="Center"/></StackPanel></Button>
                                <TextBlock x:Name="MediaGridCountText" Grid.Column="6"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Text="0 mídias" Margin="5,0,9,0" FontSize="11"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                <Border Grid.Column="7" CornerRadius="7" Margin="0,0,7,0"
                                        Height="41" Background="{DynamicResource GuiaPlayControlSurfaceBrush}"
                                        BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1">
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource GPSearch}" Width="19" Height="19"
                                              Stretch="Uniform" Fill="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                              VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="MediaSearchBox" Height="37" VerticalContentAlignment="Center"
                                                     Background="Transparent" BorderThickness="0" Padding="5,0"
                                                     MinWidth="120" FontSize="12"
                                                     TextChanged="MediaSearchBox_OnTextChanged"
                                                     ToolTip="Buscar por nome, pasta e caminho (Ctrl + F)"
                                                     AutomationProperties.Name="Buscar na playlist"/>
                                            <TextBlock x:Name="MediaSearchHint" Text="Buscar na playlist..."
                                                       IsHitTestVisible="False" FontSize="12" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="8" x:Name="PlaylistOptionsMenuButton"
                                        Click="PlaylistOptionsMenuButton_OnClick"
                                        Height="41" Width="40" MinWidth="0" Padding="7,2"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Opções da playlist e modo de reprodução"
                                        AutomationProperties.Name="Opções da playlist">
                                    <Path Data="{StaticResource GPPlaylist}" Width="21" Height="21"
                                          Stretch="Uniform" Fill="{DynamicResource GuiaPlayTextPrimaryBrush}"/>
                                </Button>
                                <!-- Programmatic entry points retained; open files via Adicionar. -->
                                <Button x:Name="OpenButton" Grid.Column="6" Visibility="Collapsed"
                                        IsTabStop="False" Content="Abrir mídia" Click="OpenButton_OnClick"/>
                                <Button x:Name="ClearMediaSearchButton" Grid.Column="6" Visibility="Collapsed"
                                        IsTabStop="False" Content="Limpar pesquisa" Click="ClearMediaSearchButton_OnClick"/>

                            </Grid>
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="MediaGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserResizeRows="False" CanUserSortColumns="False"
                                          CanUserReorderColumns="False" IsReadOnly="True"
                                          RowHeaderWidth="0" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0" Background="Transparent"
                                          Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}"
                                          BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          AlternatingRowBackground="{DynamicResource GuiaPlaySurfaceSecondaryBrush}"
                                          RowBackground="{DynamicResource GuiaPlayControlSurfaceBrush}"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          AllowDrop="True"
                                          AutomationProperties.Name="Tabela de mídias em ordem de reprodução"
                                          SelectionChanged="MediaGrid_OnSelectionChanged"
                                          MouseDoubleClick="MediaGrid_OnMouseDoubleClick"
                                          PreviewMouseLeftButtonDown="MediaGrid_OnPreviewMouseLeftButtonDown"
                                          PreviewMouseMove="MediaGrid_OnPreviewMouseMove"
                                          PreviewDragOver="MediaGrid_OnPreviewDragOver"
                                          Drop="MediaGrid_OnDrop">
                                    <DataGrid.Resources>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="Background" Value="{DynamicResource GuiaPlaySurfaceSecondaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Padding" Value="10,11" />
                                        </Style>
                                        <Style TargetType="{x:Type DataGridRow}">
                                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
                                            <Setter Property="Padding" Value="8,7" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding OrderText}" Width="41" />
                                        <DataGridTemplateColumn Header="Mídia" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid ToolTip="{Binding FilePath}" Margin="2,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="57" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="61" Height="40" Background="#FF17232F"
                                                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                                                                BorderThickness="1" CornerRadius="4"
                                                                VerticalAlignment="Center" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                <TextBlock Text="{Binding Glyph}" FontSize="18" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource GuiaPlayAccentBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" FontSize="12" />
                                                            <TextBlock Text="{Binding AvailabilityLabel}" FontSize="10"
                                                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Duração" Binding="{Binding Duration}" Width="*" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="*" />
                                        <DataGridTextColumn Header="Resolução" Binding="{Binding Resolution}" Width="*" />
                                        <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="*" />
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding GroupName}" Width="*" />
                                        <DataGridTemplateColumn Header="Ações" Width="62">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="⋯" Width="31" MinWidth="0" Height="27"
                                                            ToolTip="Abrir ações da mídia"
                                                            Style="{StaticResource CompactTransportButtonStyle}"
                                                            Tag="{Binding}" Click="MediaRowActionsButton_OnClick" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="MediaGridEmptyText" Text="Crie um grupo e adicione mídias para montar a reprodução."
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="15"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
        </Grid>

        <Border x:Name="LicenseBlockedOverlay" Grid.Row="1" Margin="14,0,14,0" Visibility="Collapsed"
                Background="{DynamicResource GuiaPlayWindowBackgroundBrush}" Opacity="0.96"
                CornerRadius="8" Panel.ZIndex="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" Margin="30">
                <Path Data="{StaticResource PersonIconGeometry}" Width="42" Height="42" Stretch="Uniform"
                      Fill="{DynamicResource GuiaPlayAccentBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="LicenseBlockedTitleText" Text="Escolha como continuar" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock x:Name="LicenseBlockedMessageText" Text="Inicie a avaliação gratuita ou ative uma licença para usar o GuiaPlay."
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16"
                           Style="{StaticResource SecondaryTextStyle}" />
                <Button Content="Abrir usuário e licença" HorizontalAlignment="Center"
                        Click="LicenseStatusButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- GP-I14: one clean operator transport line, mirroring the approved design. -->
        <Border x:Name="OperationalControlPanel" Grid.Row="2"
                Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}"
                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="17,8,17,8" MinHeight="111">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*" MinWidth="370"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <!-- Identity and actual progress of current media. -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="78" Height="74" Background="{DynamicResource GuiaPlayControlSurfaceBrush}"
                            CornerRadius="7" BorderThickness="1" ClipToBounds="True"
                            BorderBrush="{DynamicResource GuiaPlayDividerBrush}" VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="TransportThumbnailImage" Stretch="UniformToFill"/>
                            <Path x:Name="TransportVideoPlaceholderIcon" Data="{StaticResource GPVideo}"
                                  Width="29" Height="29" Stretch="Uniform" Fill="{DynamicResource GuiaPlayAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path x:Name="TransportAudioPlaceholderIcon" Data="{StaticResource MusicIconGeometry}"
                                  Width="29" Height="29" Stretch="Uniform" Fill="{DynamicResource GuiaPlayAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Text, ElementName=FileNameText}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=FileNameText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,3">
                            <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="12"/>
                            <TextBlock Text=" / " Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"/>
                            <TextBlock x:Name="RemainingText" Text="00:00" FontSize="12"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"/>
                        </StackPanel>
                        <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" Value="0" Height="17"
                                Foreground="{DynamicResource GuiaPlayAccentBrush}" ToolTip="Posição da mídia"
                                ValueChanged="ProgressSlider_OnValueChanged" IsEnabled="False"
                                PreviewMouseLeftButtonDown="ProgressSlider_OnDragStarted"
                                PreviewMouseLeftButtonUp="ProgressSlider_OnDragCompleted"
                                PreviewMouseWheel="ProgressSlider_OnMouseWheel"/>
                    </StackPanel>
                </Grid>
                <!-- PLAY and PAUSE share a single central circle. STOP occupies the old pause slot. -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto" VerticalAlignment="Center" Focusable="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="PreviousMediaButton" Click="PreviousMediaButton_OnClick" IsEnabled="False"
                                           Style="{StaticResource GPRoundTransport}" ToolTip="Mídia anterior (F8)">
                                        <Path Data="{StaticResource GPSkipPrevious}" Width="24" Height="24"
                                              Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                        <Button x:Name="BackFiveButton" Click="BackFiveButton_OnClick" IsEnabled="False"
                                           Style="{StaticResource GPRoundTransport}" ToolTip="Voltar cinco segundos">
                                        <Path Data="{StaticResource GPBackFive}" Width="24" Height="24"
                                              Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                        <Button x:Name="PlayButton" Click="MainPlayPauseButton_OnClick"
                                Style="{StaticResource GPPlayTransport}" IsEnabled="False"
                                ToolTip="Reproduzir (F5 / Espaço)" AutomationProperties.Name="Reproduzir ou pausar">
                            <Grid>
                                <Path x:Name="MainPlayGlyph" Data="{StaticResource PlayIconGeometry}"
                                      Width="44" Height="44" Stretch="Uniform" Fill="White"/>
                                <Path x:Name="MainPauseGlyph" Data="{StaticResource PauseIconGeometry}"
                                      Width="40" Height="40" Stretch="Uniform" Fill="White" Visibility="Collapsed"/>
                                <TextBlock x:Name="PlayButtonText" Text="Reproduzir" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="StopButton" Click="StopButton_OnClick" IsEnabled="False"
                                           Style="{StaticResource GPRoundTransport}" ToolTip="Parar reprodução (F7)">
                                        <Path Data="{StaticResource StopIconGeometry}" Width="24" Height="24"
                                              Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                        <Button x:Name="ForwardFiveButton" Click="ForwardFiveButton_OnClick" IsEnabled="False"
                                           Style="{StaticResource GPRoundTransport}" ToolTip="Avançar cinco segundos">
                                        <Path Data="{StaticResource GPForwardFive}" Width="24" Height="24"
                                              Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                        <Button x:Name="NextMediaButton" Click="NextMediaButton_OnClick" IsEnabled="False"
                                           Style="{StaticResource GPRoundTransport}" ToolTip="Próxima mídia (F9)">
                                        <Path Data="{StaticResource GPSkipNext}" Width="24" Height="24"
                                              Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                    </StackPanel>
                </ScrollViewer>
                <!-- Sole volume control and operational modes, aligned with transport. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="MuteButton" Click="MuteButton_OnClick"
                            Width="39" Height="39" MinWidth="0" MinHeight="0" Padding="7"
                            BorderThickness="0" Background="Transparent"
                            ToolTip="Silenciar ou ativar áudio">
                        <Grid Width="24" Height="24">
                            <Path x:Name="SpeakerIcon" Data="{StaticResource GPVolumeUp}" Stretch="Uniform"
                                  Fill="{DynamicResource GuiaPlayTextPrimaryBrush}"/>
                            <Path x:Name="SpeakerLowIcon" Data="{StaticResource GPVolumeDown}" Stretch="Uniform"
                                  Fill="{DynamicResource GuiaPlayTextPrimaryBrush}" Visibility="Collapsed"/>
                            <Path x:Name="SpeakerMuteIcon" Data="{StaticResource GPVolumeMute}" Stretch="Uniform"
                                  Fill="{DynamicResource GuiaPlayTextPrimaryBrush}" Visibility="Collapsed"/>
                            <TextBlock x:Name="MuteButtonText" Text="Mudo" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" Value="100"
                            Margin="5,0,5,0" VerticalAlignment="Center" ToolTip="Volume do GuiaPlay"
                            Foreground="{DynamicResource GuiaPlayAccentBrush}"
                            ValueChanged="VolumeSlider_OnValueChanged" PreviewMouseWheel="VolumeSlider_OnMouseWheel"/>
                    <TextBlock x:Name="VolumeText" Text="100%" Width="43" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <CheckBox x:Name="ShufflePlaylistCheckBox" Style="{StaticResource GPPlaybackToggle}"
                              ToolTip="Reprodução aleatória" AutomationProperties.Name="Alternar reprodução aleatória"
                              Checked="ShufflePlaylistCheckBox_OnChanged"
                              Unchecked="ShufflePlaylistCheckBox_OnChanged">
                        <Path Data="{StaticResource GPShuffle}" Width="23" Height="23" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
                    </CheckBox>
                    <Button x:Name="RepeatModeButton" Click="RepeatModeButton_OnClick"
                            Style="{StaticResource CompactTransportButtonStyle}" Width="38" Height="38"
                            MinWidth="0" MinHeight="0" Padding="7" Margin="2,0"
                            ToolTip="Alternar repetição (desativada / mídia / playlist)">
                        <Grid>
                            <Path Data="{StaticResource GPRepeat}" Width="23" Height="23" Stretch="Uniform"
                                  Fill="{DynamicResource GuiaPlayTextPrimaryBrush}"/>
                            <TextBlock x:Name="RepeatModeButtonText" Text="Repetir: Não" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="FullscreenPreviewButton" Click="FullscreenPreviewButton_OnClick"
                            Style="{StaticResource CompactTransportButtonStyle}" Width="40" Height="40"
                            MinWidth="0" MinHeight="0" Padding="7" Margin="4,0,0,0" IsEnabled="False"
                            ToolTip="Abrir prévia do operador em tela cheia (F11; Esc para sair)"
                            AutomationProperties.Name="Prévia do operador em tela cheia">
                        <Path Data="{StaticResource GPFullscreenCornerGeometry}" Width="24" Height="24"
                              Stretch="Uniform" Stroke="{DynamicResource GuiaPlayTextPrimaryBrush}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
                <!-- Existing workflow handles remain alive but outside the visual reference. -->
                <StackPanel Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False">
                    <Button x:Name="PauseButton" Click="PauseButton_OnClick" IsEnabled="False" IsTabStop="False"/>
                    <ComboBox x:Name="PlaybackModeCombo" Width="130" Height="28"
                              SelectionChanged="PlaybackModeCombo_OnSelectionChanged" IsTabStop="False">
                        <ComboBoxItem Content="Modo: Manual"/>
                        <ComboBoxItem Content="Modo: Sequencial"/>
                    </ComboBox>
                    <Border x:Name="OperatorIndicatorBorder">
                        <TextBlock x:Name="OperatorIndicatorText" Text="Nenhuma tela"/>
                    </Border>
                    <ItemsControl x:Name="OutputsList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding ShortLabel}"
                                      ToolTip="{Binding Label}" Style="{StaticResource OutputChipStyle}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NextPlaylistItemText" Text="Próxima: nenhuma"/>
                    <TextBlock x:Name="StatusText" Text="Pronto"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
