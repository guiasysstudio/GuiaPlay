<Window x:Class="GuiaPlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GuiaPlay.App.Models"
        Title="GuiaPlay"
        Icon="/GuiaPlay;component/Assets/Branding/Icons/GuiaPlay.ico"
        Width="1450" Height="830" MinWidth="980" MinHeight="590"
        Background="{DynamicResource GuiaPlayWindowBackgroundBrush}"
        Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CompactTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="PlaylistCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <!-- GP-I01: all header actions map to existing, tested application workflows. -->
        <Style x:Key="HeaderNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderNavigationIconStyle" TargetType="Path" BasedOn="{StaticResource ButtonIconStyle}">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="SavedPlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutputChipStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GuiaPlayControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CheckGlyph" Text="✓" Margin="0,0,5,0" FontWeight="SemiBold" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                                <Setter TargetName="ChipSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBorderBrush}" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipSurface" Property="BorderBrush" Value="{DynamicResource GuiaPlayAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:PlaylistGroupNode}" ItemsSource="{Binding Items}">
            <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource FolderOpenIconGeometry}" Width="15" Height="15"
                      Fill="{DynamicResource GuiaPlayAccentBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="5,0,0,0"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Margin="6,0,2,0" Padding="7,2" CornerRadius="9"
                        Background="{DynamicResource GuiaPlayAccentSubtleBrush}">
                    <TextBlock Text="{Binding Items.Count}" FontSize="11" />
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:PlaylistItemNode}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Path x:Name="ItemKindIcon" Data="{StaticResource VideoIconGeometry}" Width="14" Height="14"
                      Stretch="Uniform" Fill="{DynamicResource GuiaPlayTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ItemName" Grid.Column="1" Margin="6,0,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="{Binding AvailabilityLabel}"
                           FontSize="11" Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding KindLabel}" Value="Áudio">
                    <Setter TargetName="ItemKindIcon" Property="Path.Data" Value="{StaticResource MusicIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="ItemName" Property="TextBlock.TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="ItemName" Property="TextBlock.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- GP-I01: top navigation follows Modelo 1 and keeps native Windows window chrome. -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}"
                Background="{DynamicResource GuiaPlaySurfaceElevatedBrush}"
                Padding="12,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Source="/GuiaPlay;component/Assets/Branding/GuiaPlay-Wordmark-UI.png"
                           Width="130" Height="41" Stretch="Uniform" ToolTip="GuiaPlay" />
                    <TextBlock x:Name="VersionHeaderText" Text="v—" Margin="7,0,0,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                               AutomationProperties.Name="Versão instalada" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="HeaderPlaylistButton" Click="HeaderPlaylistButton_OnClick"
                                Style="{StaticResource HeaderNavigationButtonStyle}"
                                Background="{DynamicResource GuiaPlayAccentBrush}"
                                Foreground="{DynamicResource GuiaPlayAccentForegroundBrush}"
                                BorderBrush="{DynamicResource GuiaPlayAccentBorderBrush}"
                                ToolTip="Ir para a playlist de trabalho" AutomationProperties.Name="Playlist">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FolderOpenIconGeometry}" Style="{StaticResource HeaderNavigationIconStyle}" />
                                <TextBlock Text="Playlist" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeaderMediaButton" Click="HeaderMediaButton_OnClick"
                                Style="{StaticResource HeaderNavigationButtonStyle}"
                                ToolTip="Abrir um vídeo ou áudio local" AutomationProperties.Name="Mídia">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource VideoIconGeometry}" Style="{StaticResource HeaderNavigationIconStyle}" />
                                <TextBlock Text="Mídia" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="HeaderSettingsButton_OnClick"
                                Style="{StaticResource HeaderNavigationButtonStyle}"
                                ToolTip="Abrir configurações" AutomationProperties.Name="Configurações">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource HeaderNavigationIconStyle}" />
                                <TextBlock Text="Configurações" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="HeaderMonitorsButton_OnClick"
                                Style="{StaticResource HeaderNavigationButtonStyle}"
                                ToolTip="Configurar operador e telas públicas" AutomationProperties.Name="Monitores">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource DisplayIconGeometry}" Style="{StaticResource HeaderNavigationIconStyle}" />
                                <TextBlock Text="Monitores" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="HeaderAboutButton_OnClick"
                                Style="{StaticResource HeaderNavigationButtonStyle}"
                                ToolTip="Sobre o GuiaPlay" AutomationProperties.Name="Sobre">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource InfoIconGeometry}" Style="{StaticResource HeaderNavigationIconStyle}" />
                                <TextBlock Text="Sobre" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="LicenseStatusButton" Content="Verificando licença…"
                            MinWidth="125" Height="38" Padding="9,5" Margin="0,0,8,0"
                            Style="{StaticResource StandardButtonStyle}"
                            ToolTip="Estado real do GuiaSys Licensing; clique para gerenciar"
                            Click="LicenseStatusButton_OnClick" />
                    <Button x:Name="UpdateAvailableButton" Visibility="Collapsed"
                            Width="38" Height="38" Padding="8" MinWidth="38"
                            Margin="0,0,7,0"
                            Background="{DynamicResource GuiaPlayAccentBrush}"
                            Foreground="{DynamicResource GuiaPlayAccentForegroundBrush}"
                            BorderBrush="{DynamicResource GuiaPlayAccentBorderBrush}"
                            ToolTip="Atualização disponível" Click="UpdateAvailableButton_OnClick">
                        <Path Data="{StaticResource ArrowDownloadIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                    </Button>
                    <Button x:Name="ConfigureScreensButton" Width="38" Height="38" Padding="8" MinWidth="38"
                            Style="{StaticResource StandardButtonStyle}" ToolTip="Configurações do programa"
                            Click="ConfigureScreensButton_OnClick">
                        <Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="LicensedWorkspace" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="265" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="345" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="246" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="44*" />
                        <RowDefinition Height="56*" />
                    </Grid.RowDefinitions>
                    <!-- GP-I05: Operator and Program use one actual shared frame source.
                         Program is a transmission mirror, not a capture of the physical monitor. -->
                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PRÉVIA E PROGRAMA" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="FileNameText" Text="Nenhuma mídia carregada"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                       Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="8,4" VerticalAlignment="Top"
                                CornerRadius="11" Background="{DynamicResource GuiaPlayAccentSubtleBrush}"
                                BorderBrush="{DynamicResource GuiaPlayAccentBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="PreviewLiveStateText" Text="AGUARDANDO"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1"
                                Background="{DynamicResource GuiaPlaySurfaceSecondaryBrush}" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,1,4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PRÉVIA DO OPERADOR" FontSize="11" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="LOCAL" FontSize="9" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="FullscreenPreviewButton" Content="⛶" IsEnabled="False"
                                                Width="28" Height="24" MinWidth="28" Padding="3"
                                                Style="{StaticResource CompactTransportButtonStyle}"
                                                ToolTip="Abrir a prévia do operador em tela cheia (Esc para sair)"
                                                AutomationProperties.Name="Prévia em tela cheia"
                                                Click="FullscreenPreviewButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True"
                                        MinHeight="110">
                                    <Grid>
                                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                                        <StackPanel x:Name="PreviewEmptyState" Margin="12"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    MaxWidth="220">
                                            <Path Data="{StaticResource VideoIconGeometry}" Width="26" Height="26"
                                                  Stretch="Uniform" Fill="#FF8F98A6"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock x:Name="PreviewPlaceholder" Text="Nenhuma mídia carregada"
                                                       Foreground="#FFE2E5EA" FontWeight="SemiBold"
                                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                            <TextBlock x:Name="PreviewEmptyHint" Text="Abra uma mídia ou selecione na playlist"
                                                       Foreground="#FF9FA7B3" FontSize="10"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Same LibVLC position as transport below; bindings prevent drift. -->
                                <Grid Grid.Row="2" Margin="2,6,2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="39" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text, ElementName=ElapsedText}"
                                               VerticalAlignment="Center" FontSize="10" />
                                    <Slider x:Name="PreviewProgressSlider" Grid.Column="1" Margin="5,0"
                                            Minimum="0" Maximum="{Binding Maximum, ElementName=ProgressSlider}"
                                            Value="{Binding Value, ElementName=ProgressSlider, Mode=TwoWay}"
                                            ValueChanged="ProgressSlider_OnValueChanged"
                                            IsEnabled="False" ToolTip="Arraste para buscar a posição do vídeo"
                                            Foreground="{DynamicResource GuiaPlayAccentBrush}"
                                            PreviewMouseLeftButtonDown="ProgressSlider_OnDragStarted"
                                            PreviewMouseLeftButtonUp="ProgressSlider_OnDragCompleted"
                                            PreviewMouseWheel="ProgressSlider_OnMouseWheel" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text, ElementName=RemainingText}"
                                               TextAlignment="Right" VerticalAlignment="Center" FontSize="9"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="8"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1"
                                Background="{DynamicResource GuiaPlaySurfaceSecondaryBrush}" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,1,4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PROGRAMA / TELA PÚBLICA" FontSize="11"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ProgramStatusBadgeText" Grid.Column="1"
                                               Text="SEM SAÍDA" FontSize="9"
                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                                </Grid>
                                <Border Grid.Row="1" Background="Black" CornerRadius="6"
                                        ClipToBounds="True" MinHeight="110">
                                    <Grid>
                                        <Image x:Name="ProgramImage" Stretch="Uniform" Visibility="Collapsed"
                                               ToolTip="Espelho do quadro entregue pelo GuiaPlay às janelas públicas; não é captura física do monitor" />
                                        <StackPanel x:Name="ProgramEmptyState" Margin="12"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    MaxWidth="220">
                                            <Path Data="{StaticResource DisplayIconGeometry}" Width="26" Height="26"
                                                  Stretch="Uniform" Fill="#FF8F98A6"
                                                  HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock x:Name="ProgramPlaceholderText"
                                                       Text="Nenhuma saída pública ativa"
                                                       Foreground="#FFE2E5EA" FontSize="12"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                            <TextBlock x:Name="ProgramDetailsText"
                                                       Text="Escolha uma tela e inicie um vídeo"
                                                       Foreground="#FF9FA7B3" FontSize="10"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <!-- GP-I03: playback-order grid linked to the existing playlist catalog. -->
                    <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource GuiaPlayControlSurfaceBrush}"
                            BorderBrush="{DynamicResource GuiaPlayDividerBrush}" Padding="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="3,0,9,0">
                                    <TextBlock Text="MÍDIAS DA PLAYLIST" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MediaGridCountText" Text="0 mídias" FontSize="10"
                                               Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="MediaSearchBox" Grid.Column="1" MinWidth="85"
                                         VerticalContentAlignment="Center" Margin="0,0,5,0"
                                         Height="30" TextChanged="MediaSearchBox_OnTextChanged"
                                         ToolTip="Buscar por nome, grupo ou caminho; a busca não altera a ordem"
                                         AutomationProperties.Name="Buscar mídias" />
                                <Button Grid.Column="2" Content="Limpar" Margin="0,0,6,0"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Limpar busca" Click="ClearMediaSearchButton_OnClick" />
                                <Button x:Name="MediaMoveUpButton" Grid.Column="3" Content="↑"
                                        MinWidth="31" IsEnabled="False" Margin="0,0,4,0"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Subir a mídia selecionada dentro do grupo"
                                        AutomationProperties.Name="Subir mídia"
                                        Click="MediaMoveUpButton_OnClick" />
                                <Button x:Name="MediaMoveDownButton" Grid.Column="4" Content="↓"
                                        MinWidth="31" IsEnabled="False"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Descer a mídia selecionada dentro do grupo"
                                        AutomationProperties.Name="Descer mídia"
                                        Click="MediaMoveDownButton_OnClick" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="MediaGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserResizeRows="False" CanUserSortColumns="False"
                                          CanUserReorderColumns="False" IsReadOnly="True"
                                          RowHeaderWidth="0" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0" Background="Transparent"
                                          Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}"
                                          BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          AlternatingRowBackground="{DynamicResource GuiaPlaySurfaceSecondaryBrush}"
                                          RowBackground="{DynamicResource GuiaPlayControlSurfaceBrush}"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          AllowDrop="True"
                                          AutomationProperties.Name="Tabela de mídias em ordem de reprodução"
                                          SelectionChanged="MediaGrid_OnSelectionChanged"
                                          MouseDoubleClick="MediaGrid_OnMouseDoubleClick"
                                          PreviewMouseLeftButtonDown="MediaGrid_OnPreviewMouseLeftButtonDown"
                                          PreviewMouseMove="MediaGrid_OnPreviewMouseMove"
                                          PreviewDragOver="MediaGrid_OnPreviewDragOver"
                                          Drop="MediaGrid_OnDrop">
                                    <DataGrid.Resources>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="Background" Value="{DynamicResource GuiaPlaySurfaceSecondaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Padding" Value="6,8" />
                                        </Style>
                                        <Style TargetType="{x:Type DataGridRow}">
                                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource GuiaPlayDividerBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
                                            <Setter Property="Padding" Value="4,3" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding OrderText}" Width="41" />
                                        <DataGridTemplateColumn Header="Mídia" Width="245">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid ToolTip="{Binding FilePath}" Margin="2,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="57" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="52" Height="35" Background="#FF17232F"
                                                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                                                                BorderThickness="1" CornerRadius="4"
                                                                VerticalAlignment="Center" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                <TextBlock Text="{Binding Glyph}" FontSize="18" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource GuiaPlayAccentBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" FontSize="12" />
                                                            <TextBlock Text="{Binding AvailabilityLabel}" FontSize="10"
                                                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Duração" Binding="{Binding Duration}" Width="76" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="66" />
                                        <DataGridTextColumn Header="Resolução" Binding="{Binding Resolution}" Width="100" />
                                        <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="92" />
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding GroupName}" Width="120" />
                                        <DataGridTemplateColumn Header="Ações" Width="62">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="⋯" Width="31" MinWidth="0" Height="27"
                                                            ToolTip="Abrir ações da mídia"
                                                            Style="{StaticResource CompactTransportButtonStyle}"
                                                            Tag="{Binding}" Click="MediaRowActionsButton_OnClick" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="MediaGridEmptyText" Text="Crie um grupo e adicione mídias para montar a reprodução."
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="15"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- GP-I02: saved presets and working groups are real persisted data, not mock folders. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="60*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardStyle}"
                        Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}" Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource FolderOpenIconGeometry}" Width="17" Height="17"
                                      Stretch="Uniform" Fill="{DynamicResource GuiaPlayAccentBrush}"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="PLAYLISTS" FontSize="14" FontWeight="SemiBold"
                                           Margin="7,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="SavedPlaylistsCountText" Text="0"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                           VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="+" ToolTip="Criar nova playlist vazia"
                                    AutomationProperties.Name="Nova playlist"
                                    Style="{StaticResource PlaylistCommandButtonStyle}"
                                    Click="NewPlaylistButton_OnClick" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="SavedPlaylistsList" Background="Transparent"
                                     BorderThickness="0" SelectionMode="Single"
                                     ItemContainerStyle="{StaticResource SavedPlaylistItemStyle}"
                                     SelectionChanged="SavedPlaylistsList_OnSelectionChanged"
                                     MouseDoubleClick="SavedPlaylistsList_OnMouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Playlists salvas">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SavedPlaylistEntry}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource FolderOpenIconGeometry}"
                                                  Fill="{DynamicResource GuiaPlayAccentBrush}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveLabel}"
                                                               Margin="3,0,0,0" FontSize="9"
                                                               Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis"
                                                           FontSize="10" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="SavedPlaylistsEmptyText"
                                       Text="Nenhuma playlist salva. Use Salvar para criar uma."
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="9" TextAlignment="Center" TextWrapping="Wrap"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Nova" Margin="0,0,3,0"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Iniciar uma playlist de trabalho vazia"
                                    Click="NewPlaylistButton_OnClick" />
                            <Button Grid.Column="1" Content="Salvar" Margin="2,0,2,0"
                                    Style="{StaticResource CompactPrimaryButtonStyle}"
                                    ToolTip="Salvar a playlist de trabalho como preset"
                                    Click="SavePlaylistPresetButton_OnClick" />
                            <Button x:Name="OpenSelectedPresetButton" Grid.Column="2" Content="Abrir"
                                    Margin="2,0,2,0" IsEnabled="False"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Carregar a playlist selecionada"
                                    Click="OpenSelectedPresetButton_OnClick" />
                            <Button x:Name="DeleteSelectedPresetButton" Grid.Column="3" Content="Excluir"
                                    Margin="3,0,0,0" IsEnabled="False"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Excluir somente o preset selecionado, com confirmação"
                                    Click="DeleteSelectedPresetButton_OnClick" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                        Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}" Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PASTAS / GRUPOS" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Grupos virtuais da lista atual" FontSize="10"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="NewGroupButton_OnClick" ToolTip="Criar grupo virtual"
                                        AutomationProperties.Name="Criar grupo"
                                        Style="{StaticResource PlaylistCommandButtonStyle}" Margin="0,0,3,0">
                                    <Path Data="{StaticResource FolderAddIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                                </Button>
                                <Button Click="RenameGroupButton_OnClick" ToolTip="Renomear grupo selecionado"
                                        AutomationProperties.Name="Renomear grupo"
                                        Style="{StaticResource PlaylistCommandButtonStyle}" Margin="0,0,3,0">
                                    <Path Data="{StaticResource EditIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                                </Button>
                                <Button Click="DeleteGroupButton_OnClick" ToolTip="Excluir grupo e referências, sem apagar mídias"
                                        AutomationProperties.Name="Excluir grupo"
                                        Style="{StaticResource PlaylistCommandButtonStyle}">
                                    <Path Data="{StaticResource DeleteIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" CornerRadius="7" Padding="4"
                                Background="{DynamicResource GuiaPlayControlSurfaceBrush}"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1">
                            <Grid>
                                <TreeView x:Name="PlaylistTree" MouseDoubleClick="PlaylistTree_OnMouseDoubleClick"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="PlaylistTree_OnPreviewMouseLeftButtonDown"
                                          PreviewMouseMove="PlaylistTree_OnPreviewMouseMove"
                                          PreviewDragOver="PlaylistTree_OnPreviewDragOver"
                                          Drop="PlaylistTree_OnDrop" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="Grupos e mídias da playlist" />
                                <StackPanel x:Name="PlaylistEmptyState" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" MaxWidth="230" IsHitTestVisible="False">
                                    <Path Data="{StaticResource FolderAddIconGeometry}"
                                          Width="27" Height="27" Stretch="Uniform"
                                          Fill="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                          HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Lista de trabalho vazia" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="Crie um grupo e adicione mídias. Pastas do computador serão importadas no GP-I04."
                                               Style="{StaticResource SecondaryTextStyle}"
                                               TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="WorkingPlaylistSummaryText" Text="0 grupos · 0 mídias"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                                <TextBlock x:Name="FolderImportStatusText" Text="Importação de pasta não iniciada"
                                           FontSize="10" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                           Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                                <Button x:Name="CancelFolderImportButton" Visibility="Collapsed" Content="Cancelar leitura"
                                        HorizontalAlignment="Left" Margin="0,3,0,0"
                                        Style="{StaticResource CompactTransportButtonStyle}"
                                        ToolTip="Cancelar varredura sem modificar a playlist"
                                        Click="CancelFolderImportButton_OnClick" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="AddMediaMenuButton_OnClick"
                                    x:Name="AddMediaMenuButton"
                                    Style="{StaticResource CompactPrimaryButtonStyle}"
                                    ToolTip="Adicionar arquivos ou importar uma pasta inteira"
                                    AutomationProperties.Name="Adicionar mídias ou pasta"
                                    Margin="3,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DocumentAddIconGeometry}" Style="{StaticResource ButtonIconStyle}" />
                                    <TextBlock Text="Adicionar ▾" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="RemovePlaylistItemButton_OnClick"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Remover referência à mídia, sem apagar o arquivo" Margin="3,0,0,0">
                                <Path Data="{StaticResource DeleteIconGeometry}" Style="{StaticResource ButtonIconStyle}" Margin="0" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- GP-I05: actual monitor topology, active output windows and configured audio. -->
            <ScrollViewer Grid.Column="4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardStyle}"
                        Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,7">
                        <TextBlock Text="TELAS E ÁUDIO" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock x:Name="OperatorPanelText" Text="Operador: detectando…"
                                   TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                        <TextBlock x:Name="OperatorStatusText" Text="Aguardando monitor do operador"
                                   TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SAÍDAS PÚBLICAS" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock x:Name="OutputSelectedCountText" Grid.Column="1"
                                   Text="0 selecionadas" FontSize="10"
                                   Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                    </Grid>
                    <Border Grid.Row="2" CornerRadius="7" BorderThickness="1"
                            BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                            Background="{DynamicResource GuiaPlayControlSurfaceBrush}" Padding="5">
                        <Grid>
                            <ItemsControl x:Name="SidebarOutputsList" Margin="0,0,2,0"
                                          VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding ShortLabel}"
                                                  ToolTip="{Binding Label}"
                                                  AutomationProperties.Name="{Binding ShortLabel}"
                                                  Margin="0,0,0,7" Padding="7,6"
                                                  Style="{StaticResource OutputChipStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoPublicMonitorsText"
                                       Text="Nenhuma tela pública disponível. Conecte outro monitor."
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,8,0,9">
                        <TextBlock Text="EM EXIBIÇÃO AGORA" FontWeight="SemiBold" FontSize="10" />
                        <TextBlock x:Name="ActiveOutputsText" Text="Nenhuma"
                                   TextWrapping="Wrap" Margin="0,4,0,3" FontSize="11"
                                   Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                        <TextBlock x:Name="MonitorWarning" TextWrapping="Wrap" FontSize="10"
                                   Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Row="4" CornerRadius="7" BorderThickness="1" Padding="9"
                            BorderBrush="{DynamicResource GuiaPlayDividerBrush}"
                            Background="{DynamicResource GuiaPlayControlSurfaceBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SAÍDA DE ÁUDIO" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="AudioAvailabilityText" Grid.Column="1"
                                           Text="Verificando" FontSize="10"
                                           Foreground="{DynamicResource GuiaPlayAccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="AudioDeviceNameText" Text="Padrão do Windows"
                                       FontSize="12" FontWeight="Medium"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="AudioWarningText" TextWrapping="Wrap"
                                       Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}"
                                       FontSize="10" Margin="0,4,0,7" />
                            <Button Content="Selecionar dispositivo de áudio…"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Abrir configurações de áudio; a rota não muda durante a reprodução"
                                    AutomationProperties.Name="Selecionar saída de áudio"
                                    Click="ChangeAudioOutputButton_OnClick" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=VolumeText}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Margin="0,4,0,4"
                                    Value="{Binding Value, ElementName=VolumeSlider, Mode=TwoWay}"
                                    ToolTip="Volume sincronizado com os controles inferiores" />
                            <Button Content="{Binding Text, ElementName=MuteButtonText}"
                                    Style="{StaticResource CompactTransportButtonStyle}"
                                    ToolTip="Ativar ou desativar áudio"
                                    Click="MuteButton_OnClick" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="5" Margin="0,9,0,0">
                        <Button Content="Identificar telas" Margin="0,0,0,5"
                                Style="{StaticResource CompactTransportButtonStyle}"
                                Click="IdentifyButton_OnClick" />
                        <Button Content="Configurar monitores"
                                Style="{StaticResource CompactTransportButtonStyle}"
                                Click="HeaderMonitorsButton_OnClick" />
                    </StackPanel>
                </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border x:Name="LicenseBlockedOverlay" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource GuiaPlayWindowBackgroundBrush}" Opacity="0.96"
                CornerRadius="8" Panel.ZIndex="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" Margin="30">
                <Path Data="{StaticResource PersonIconGeometry}" Width="42" Height="42" Stretch="Uniform"
                      Fill="{DynamicResource GuiaPlayAccentBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="LicenseBlockedTitleText" Text="Escolha como continuar" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock x:Name="LicenseBlockedMessageText" Text="Inicie a avaliação gratuita ou ative uma licença para usar o GuiaPlay."
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16"
                           Style="{StaticResource SecondaryTextStyle}" />
                <Button Content="Abrir usuário e licença" HorizontalAlignment="Center"
                        Click="LicenseStatusButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>

        <Border x:Name="OperationalControlPanel" Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource CardStyle}"
                Background="{DynamicResource GuiaPlaySurfaceSecondaryBrush}" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" Text="00:00" VerticalAlignment="Center" />
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="7,0" Minimum="0" Maximum="1" Value="0"
                            Foreground="{DynamicResource GuiaPlayAccentBrush}"
                            ToolTip="Posição da mídia" IsEnabled="False" ValueChanged="ProgressSlider_OnValueChanged"
                            PreviewMouseLeftButtonDown="ProgressSlider_OnDragStarted"
                            PreviewMouseLeftButtonUp="ProgressSlider_OnDragCompleted" PreviewMouseWheel="ProgressSlider_OnMouseWheel" />
                    <TextBlock x:Name="RemainingText" Grid.Column="2" Text="-00:00 / 00:00" VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="OpenButton" Content="Abrir mídia…" Click="OpenButton_OnClick" Style="{StaticResource CompactTransportButtonStyle}" Margin="0,0,6,0" />
                        <Button x:Name="PreviousMediaButton" Content="|◀" Click="PreviousMediaButton_OnClick"
                                IsEnabled="False" ToolTip="Carregar a mídia anterior sem reproduzir automaticamente"
                                Style="{StaticResource CompactTransportButtonStyle}" Margin="0,0,5,0" />
                        <Button x:Name="BackFiveButton" Content="−5s" Click="BackFiveButton_OnClick"
                                IsEnabled="False" ToolTip="Voltar cinco segundos"
                                Style="{StaticResource CompactTransportButtonStyle}" Margin="0,0,5,0" />
                        <Button x:Name="PlayButton" Click="PlayButton_OnClick" IsEnabled="False" Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,6,0" ToolTip="Reproduzir mídia">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlayIconGeometry}" Style="{StaticResource ButtonIconStyle}" /><TextBlock x:Name="PlayButtonText" Text="Reproduzir" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="PauseButton" Click="PauseButton_OnClick" IsEnabled="False" Style="{StaticResource CompactTransportButtonStyle}" Margin="0,0,6,0" ToolTip="Pausar reprodução">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PauseIconGeometry}" Style="{StaticResource ButtonIconStyle}" /><TextBlock Text="Pausar" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="ForwardFiveButton" Content="+5s" Click="ForwardFiveButton_OnClick"
                                IsEnabled="False" ToolTip="Avançar cinco segundos"
                                Style="{StaticResource CompactTransportButtonStyle}" Margin="0,0,5,0" />
                        <Button x:Name="NextMediaButton" Content="▶|" Click="NextMediaButton_OnClick"
                                IsEnabled="False" ToolTip="Carregar a próxima mídia sem reproduzir automaticamente"
                                Style="{StaticResource CompactTransportButtonStyle}" Margin="0,0,5,0" />
                        <Button x:Name="StopButton" Click="StopButton_OnClick" IsEnabled="False" Style="{StaticResource CompactTransportButtonStyle}" ToolTip="Parar reprodução">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource StopIconGeometry}" Style="{StaticResource ButtonIconStyle}" /><TextBlock Text="Parar" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </WrapPanel>
                    <Border Grid.Column="1" Margin="8,0" Padding="8,3" CornerRadius="11"
                            Background="{DynamicResource GuiaPlayControlSurfaceBrush}"
                            BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1">
                        <TextBlock x:Name="StatusText" Text="Pronto" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Click="MuteButton_OnClick" Style="{StaticResource CompactTransportButtonStyle}" MinWidth="78" ToolTip="Ativar ou desativar o som">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="SpeakerIcon" Data="{StaticResource SpeakerIconGeometry}" Style="{StaticResource ButtonIconStyle}" />
                                <Path x:Name="SpeakerMuteIcon" Data="{StaticResource SpeakerMuteIconGeometry}" Style="{StaticResource ButtonIconStyle}" Visibility="Collapsed" />
                                <TextBlock x:Name="MuteButtonText" Text="Mudo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="100" Margin="7,0"
                                Foreground="{DynamicResource GuiaPlayAccentBrush}"
                                ToolTip="Volume do GuiaPlay" ValueChanged="VolumeSlider_OnValueChanged" PreviewMouseWheel="VolumeSlider_OnMouseWheel" />
                        <TextBlock x:Name="VolumeText" Text="100%" Width="42" VerticalAlignment="Center" TextAlignment="Right" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Operador" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                    <Border x:Name="OperatorIndicatorBorder" Grid.Column="1" Margin="7,0,10,0" Padding="7,2" MinWidth="120" MaxWidth="220"
                            CornerRadius="11" Background="{DynamicResource GuiaPlayAccentSubtleBrush}"
                            BorderBrush="{DynamicResource GuiaPlayAccentBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="OperatorIndicatorText" Text="Nenhuma tela" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="OutputsList" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding ShortLabel}" ToolTip="{Binding Label}" Style="{StaticResource OutputChipStyle}" VerticalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button x:Name="IdentifyButton" Grid.Column="3" Content="Identificar telas" Style="{StaticResource CompactTransportButtonStyle}" Click="IdentifyButton_OnClick" />
                </Grid>
                <!-- Manual is the safe default: no automatic transition on media end. -->
                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PlaybackModeCombo" Width="142" Height="30"
                              ToolTip="Modo manual não inicia outra mídia ao terminar"
                              AutomationProperties.Name="Modo de reprodução"
                              SelectionChanged="PlaybackModeCombo_OnSelectionChanged"
                              Margin="0,0,6,0">
                        <ComboBoxItem Content="Modo: Manual" />
                        <ComboBoxItem Content="Modo: Sequencial" />
                    </ComboBox>
                    <Button x:Name="RepeatModeButton" Grid.Column="1" MinWidth="116"
                            Click="RepeatModeButton_OnClick"
                            ToolTip="Alterna entre não repetir, repetir a atual e repetir a lista"
                            Style="{StaticResource CompactTransportButtonStyle}" Margin="0,0,7,0">
                        <TextBlock x:Name="RepeatModeButtonText" Text="Repetir: Não" />
                    </Button>
                    <CheckBox x:Name="ShufflePlaylistCheckBox" Grid.Column="2" Content="Aleatório"
                              ToolTip="Seleciona um próximo item aleatório, sem repetir a atual"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="ShufflePlaylistCheckBox_OnChanged"
                              Unchecked="ShufflePlaylistCheckBox_OnChanged" />
                    <TextBlock x:Name="NextPlaylistItemText" Grid.Column="3"
                               Text="Próxima: nenhuma mídia selecionada"
                               FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Foreground="{DynamicResource GuiaPlayTextSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
