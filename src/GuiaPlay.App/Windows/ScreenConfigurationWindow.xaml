<Window x:Class="GuiaPlay.App.Windows.ScreenConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — GuiaPlay"
        Icon="/GuiaPlay;component/Assets/Branding/Icons/GuiaPlay.ico"
        Width="960" Height="650" MinWidth="780" MinHeight="520"
        Background="{DynamicResource GuiaPlayWindowBackgroundBrush}"
        Foreground="{DynamicResource GuiaPlayTextPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/GuiaPlay;component/Assets/Branding/GuiaPlay-Wordmark-UI.png"
                   Width="116" Height="38" Margin="0,0,16,0" Stretch="Uniform"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Configurações" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}"
                           Text="Preferências permanentes; ações explícitas de integração são aplicadas imediatamente." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Border Width="180" HorizontalAlignment="Left" Background="{DynamicResource GuiaPlaySidebarBrush}"
                    BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1" CornerRadius="9" />
            <Border Margin="180,0,0,0" Background="{DynamicResource GuiaPlaySurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1" CornerRadius="9" />
            <TabControl x:Name="SettingsTabs" TabStripPlacement="Left"
                        Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="MinWidth" Value="168" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="14,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Margin" Value="0,0,12,4" />
                    <Setter Property="Foreground" Value="{DynamicResource GuiaPlayTextPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GuiaPlayControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GuiaPlaySelectionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GuiaPlaySelectionForegroundBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>
            <TabItem x:Name="ScreensTab" Header="Telas">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="Escolha uma única tela para o operador e dê nomes curtos às telas. O operador nunca será uma saída pública." />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ScreensList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton GroupName="OperatorScreen" IsChecked="{Binding IsOperator, Mode=TwoWay}"
                                                     VerticalAlignment="Center" Margin="2,0,14,0" Content="Operador" />
                                        <TextBox Grid.Column="1" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="40" MinHeight="36" VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding CanPersist}" ToolTip="Nome personalizado (até 40 caracteres)" />
                                        <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Monitor.ShortLabel}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding IdentitySummary}" TextWrapping="Wrap"
                                                       Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="DisconnectedText" Grid.Row="2" Margin="2,12,2,2" TextWrapping="Wrap"
                               Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
            </TabItem>

            <TabItem x:Name="AppearanceTab" Header="Aparência">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="Aparência" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,18" Style="{StaticResource SecondaryTextStyle}"
                                   Text="Escolha o modo base e uma cor de destaque profissional. Alto contraste do Windows sempre tem prioridade." />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Modo" Style="{StaticResource SectionTitleStyle}" />
                                <ComboBox x:Name="AppearanceCombo" Width="280" MinHeight="38"
                                          HorizontalAlignment="Left" DisplayMemberPath="Label"
                                          SelectionChanged="AppearanceSelection_OnChanged" />
                                <TextBlock Margin="0,7,0,0" Style="{StaticResource SecondaryTextStyle}"
                                           Text="Sistema acompanha Claro/Escuro do Windows durante a execução." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Cor de destaque" Style="{StaticResource SectionTitleStyle}" />
                                <WrapPanel>
                                    <RadioButton x:Name="BlueAccentRadio" GroupName="Accent" Margin="0,4,18,8" Checked="AppearanceSelection_OnChanged"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FF1674C5" Margin="0,0,7,0" /><TextBlock Text="GuiaPlay Azul" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="CyanAccentRadio" GroupName="Accent" Margin="0,4,18,8" Checked="AppearanceSelection_OnChanged"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FF008A94" Margin="0,0,7,0" /><TextBlock Text="Ciano" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="PurpleAccentRadio" GroupName="Accent" Margin="0,4,18,8" Checked="AppearanceSelection_OnChanged"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FF7A52C7" Margin="0,0,7,0" /><TextBlock Text="Roxo" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="GreenAccentRadio" GroupName="Accent" Margin="0,4,18,8" Checked="AppearanceSelection_OnChanged"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FF15936E" Margin="0,0,7,0" /><TextBlock Text="Verde" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="OrangeAccentRadio" GroupName="Accent" Margin="0,4,18,8" Checked="AppearanceSelection_OnChanged"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FFC06010" Margin="0,0,7,0" /><TextBlock Text="Laranja" /></StackPanel></RadioButton>
                                    <RadioButton x:Name="PinkAccentRadio" GroupName="Accent" Margin="0,4,18,8" Checked="AppearanceSelection_OnChanged"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FFC13D78" Margin="0,0,7,0" /><TextBlock Text="Rosa" /></StackPanel></RadioButton>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AppearancePreviewCard" Padding="14" CornerRadius="10" BorderThickness="1">
                            <StackPanel x:Name="AppearancePreviewContent">
                                <TextBlock Text="Prévia" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Margin="0,5,0,12" Text="Fundo, sidebar, cards, controles, seleção e accent são resolvidos como uma paleta completa."
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <Border x:Name="AppearancePreviewSurface" Padding="10" CornerRadius="8" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="AppearancePreviewSidebar" Padding="9" CornerRadius="6" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Configurações" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <Border x:Name="AppearancePreviewSelection" Padding="8,6" CornerRadius="5">
                                                    <TextBlock x:Name="AppearancePreviewSelectionText" Text="Aparência" />
                                                </Border>
                                                <TextBlock Text="Áudio" Margin="8,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AppearancePreviewSecondary" Grid.Column="1" Padding="12" CornerRadius="6" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Card de conteúdo" FontWeight="SemiBold" />
                                                <TextBlock Text="Superfície secundária" Margin="0,3,0,12" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="AppearancePreviewAccent" Content="Ação principal" Padding="14,7" Margin="0,0,8,0" />
                                                    <Border x:Name="AppearancePreviewControl" Padding="10,7" CornerRadius="5">
                                                        <TextBlock Text="Controle" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AudioTab" Header="Áudio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Áudio" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,18" Style="{StaticResource SecondaryTextStyle}"
                                   Text="Saída e equalização nativa do LibVLC. O volume operacional permanece na tela principal." />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Dispositivo de áudio" Style="{StaticResource SectionTitleStyle}" />
                                <ComboBox x:Name="AudioOutputCombo" MinHeight="38" DisplayMemberPath="Label" />
                                <TextBlock x:Name="AudioHelpText" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Equalizador" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="EqualizerEnabledCheckBox" Margin="0,12,0,6"
                                          Content="Ativar equalizador" Checked="EqualizerEnabledCheckBox_OnChanged"
                                          Unchecked="EqualizerEnabledCheckBox_OnChanged" />
                                <TextBlock x:Name="EqualizerAvailabilityText" Margin="0,0,0,14"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <StackPanel x:Name="EqualizerControlsPanel">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Preset" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox x:Name="EqualizerPresetCombo" Grid.Column="1" MinHeight="36"
                                                  DisplayMemberPath="Label"
                                                  SelectionChanged="EqualizerPresetCombo_OnSelectionChanged" />
                                    </Grid>
                                    <Grid Margin="0,14,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pré-amplificação" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Slider x:Name="PreampSlider" Grid.Column="1" Minimum="-20" Maximum="20"
                                                TickFrequency="1" ValueChanged="EqualizerValue_OnChanged" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=PreampSlider, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Bandas" Margin="0,10,0,6" FontWeight="SemiBold" />
                                    <ItemsControl x:Name="EqualizerBandsItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="74" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding FrequencyLabel}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="-20" Maximum="20" TickFrequency="1"
                                                            Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ValueChanged="EqualizerValue_OnChanged" />
                                                    <TextBlock Grid.Column="2" Text="{Binding GainLabel}" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"
                                               Text="Faixa nativa: -20 dB a +20 dB. Alterar preamp ou banda seleciona Personalizado." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="UpdatesTab" Header="Atualizações">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Atualizações do GuiaPlay" FontSize="18" FontWeight="SemiBold" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Versão atual" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Data da versão" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentReleaseDateText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                        </Grid>

                        <Border Margin="0,18,0,16" Padding="12" CornerRadius="6"
                                Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="UpdateStatusText" Text="Ainda não verificado." FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="AvailableVersionText" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                                <TextBlock x:Name="ReleaseNotesText" Margin="0,8,0,0" MaxHeight="90" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                                <StackPanel x:Name="UpdateProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" />
                                    <TextBlock x:Name="UpdateProgressText" Margin="0,7,0,0"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="CheckUpdatesAutomaticallyCheckBox"
                                  Content="Verificar atualizações automaticamente" Margin="0,0,0,10" />
                        <CheckBox x:Name="InstallUpdatesAutomaticallyCheckBox"
                                  Content="Instalar atualizações automaticamente" Margin="0,0,0,6" />
                        <TextBlock Text="A instalação automática nunca interrompe mídia ativa e só funciona em uma instalação feita pelo GuiaPlay Setup."
                                   Style="{StaticResource SecondaryTextStyle}" Margin="24,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckUpdatesButton" Content="Procurar atualizações"
                                    Click="CheckUpdatesButton_OnClick" Style="{StaticResource StandardButtonStyle}" Margin="0,0,8,0" />
                            <Button x:Name="InstallUpdateButton" Content="Baixar e instalar"
                                    Click="InstallUpdateButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="CancelDownloadButton" Content="Cancelar download"
                                    Click="CancelDownloadButton_OnClick" Style="{StaticResource StandardButtonStyle}"
                                    Margin="8,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="WindowsIntegrationTab" Header="Integração com Windows">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Integração com Windows e Explorer" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,16" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="O GuiaPlay pode se registrar como opção compatível sem assumir formatos nem alterar o player padrão." />

                        <Border Padding="12" CornerRadius="6"
                                Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Integração com Explorer" FontWeight="SemiBold" />
                                <TextBlock x:Name="ExplorerIntegrationStatusText" Grid.Column="1" />
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Associações" FontWeight="SemiBold" />
                                <TextBlock x:Name="AssociationsStatusText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <CheckBox x:Name="RegisterAssociationsCheckBox" Margin="0,18,0,10"
                                  Content="Registrar o GuiaPlay em Abrir com para formatos compatíveis" />
                        <CheckBox x:Name="RegisterContextMenuCheckBox" Margin="0,0,0,6"
                                  Content="Adicionar Abrir com GuiaPlay ao menu de contexto" />
                        <TextBlock Margin="24,0,0,16" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="As opções são por usuário e podem ser removidas aqui. O Windows continua controlando os aplicativos padrão." />

                        <WrapPanel>
                            <Button x:Name="ConfigureWindowsIntegrationButton" Content="Configurar integração"
                                    Click="ConfigureWindowsIntegrationButton_OnClick"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                            <Button Content="Abrir configurações de aplicativos padrão"
                                    Click="OpenDefaultAppsButton_OnClick"
                                    Style="{StaticResource StandardButtonStyle}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock x:Name="WindowsIntegrationMessageText" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DiagnosticsTab" Header="Diagnóstico">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Diagnóstico da sessão" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,14" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Snapshot leve para suporte e testes. Atualizado a cada dois segundos; não inclui caminhos completos, conteúdo de mídia, tokens ou métrica estimada de GPU." />
                        <Border Padding="12" CornerRadius="6"
                                Background="{DynamicResource GuiaPlaySurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource GuiaPlayDividerBrush}" BorderThickness="1">
                            <TextBlock x:Name="DiagnosticText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Button Content="Copiar diagnóstico" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="CopyDiagnosticsButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
                        <TextBlock x:Name="DiagnosticCopyStatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AboutTab" Header="Sobre">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22" MaxWidth="580" HorizontalAlignment="Left">
                        <Image Source="/GuiaPlay;component/Assets/Branding/GuiaPlay-Wordmark-UI.png"
                               Width="190" Height="64" Stretch="Uniform"
                               HorizontalAlignment="Left" Margin="0,0,0,18" />
                        <TextBlock Text="GuiaPlay" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutVersionText" Margin="0,6,0,0" />
                        <TextBlock Text="GuiaSys Studio" Margin="0,6,0,0" />
                        <TextBlock x:Name="AboutReleaseDateText" Margin="0,6,0,18" />
                        <Button Content="Abrir página do projeto" HorizontalAlignment="Left"
                                Style="{StaticResource StandardButtonStyle}"
                                Click="OpenProjectPageButton_OnClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <Button x:Name="CloseSettingsButton" Grid.Column="1" Content="Cancelar" Click="CancelButton_OnClick"
                    Style="{StaticResource StandardButtonStyle}" Margin="12,0,8,0" />
            <Button x:Name="SaveSettingsButton" Grid.Column="2" Content="Salvar" Click="SaveButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
